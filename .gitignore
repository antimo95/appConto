node_modules/
dist/
.angular/

# Database
apps/backend/data/*.db
apps/backend/data/*.sqlite
apps/backend/data/*.sqlite3

# Runtime data (posizione storica, precedente a DATA_ROOT)
apps/backend/data/

# DATA_ROOT: database, backup, log e temporanei dell'utente
/data/

# Configurazione locale: settings.example.json e' invece versionato
/config/settings.json

# Environment
.env
.env.*
# Package portatile prodotto da "npm run package"
/dist-package/

.superpowers/

# Cedolini veri usati per provare il parser in locale: dati personali, mai nel repository
/samples/*.pdf

# Playwright (test end-to-end): risultati, report e tracce
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# taste-skill: schermate e report del controllo grafico (locali)
/.taste-skill/
