{
  // Solo per l'editor e per il controllo dei tipi (`npx tsc -p e2e`):
  // Playwright esegue i test con il proprio caricatore, senza compilarli.
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "**/*.ts",
    "../playwright.config.ts",
    // Il costruttore dei PDF sintetici importa (solo come tipo) il lettore PDF del backend.
    "../apps/backend/src/modules/payslips/parsing/pdfjs-worker.d.ts"
  ]
}
